# LitPulse OS Environment Configuration
PORT=3000

# Intuit / QuickBooks Online OAuth 2.0 Read-Only Configuration
QUICKBOOKS_ENVIRONMENT=sandbox # Set to 'production' for live company data
QUICKBOOKS_CLIENT_ID=your_intuit_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_intuit_client_secret_here
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QUICKBOOKS_REALM_ID=your_14_digit_company_realm_id_here
QUICKBOOKS_REFRESH_TOKEN=your_oauth2_refresh_token_here

# HubSpot CRM Private Access Token (Read-Only)
HUBSPOT_ACCESS_TOKEN=pat-na1-your_hubspot_private_access_token_here

